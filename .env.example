SUB2API_BASE_URL=https://your-sub2api-host
SUB2API_ADMIN_API_KEY=replace-with-admin-api-key
SUB2API_ACCOUNT_IDS=1
MASK_ACCOUNT_NAMES=false
DISPLAY_USAGE_WINDOWS=5h,7d
ENABLE_ANNOUNCEMENTS=true
REFRESH_INTERVAL_SECONDS=60
OPENAI_STATUS_REFRESH_INTERVAL_SECONDS=10
NEXT_PUBLIC_PANEL_TITLE=sub2api upstream status

# Optional server-side timeout for sub2api admin API requests.
SUB2API_REQUEST_TIMEOUT_MS=15000

# Optional server-side timeout for OpenAI Status requests.
OPENAI_STATUS_REQUEST_TIMEOUT_MS=8000
